# Copy this file to `.env` (same folder) and fill in real values.
# .env is gitignored — never commit real credentials, and never paste real
# credentials into this .example file either.

# Required for Supabase Postgres access.
SPRING_DATASOURCE_USERNAME=your-supabase-username
SPRING_DATASOURCE_PASSWORD=your-supabase-password

# Required for the "Send Statistics to Gmail" dashboard feature.
# MAIL_USERNAME is the Gmail address that will send the PDF.
# MAIL_PASSWORD must be a 16-character Google App Password, NOT the account login password:
#   1. Enable 2-Step Verification on the Google account: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine, Google ignores them)
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Optional overrides (defaults already target Gmail's SMTP relay)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# Set to true temporarily to print the full SMTP conversation to the console
# when troubleshooting a connection/handshake failure.
# MAIL_DEBUG=true
